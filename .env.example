# Copia este fichero a .env y rellena los valores. .env esta en .gitignore.

# --- Telegram (obligatorio para publicar) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_id_here
# Canal de pruebas, usado con --use-test-channel
TELEGRAM_CHANNEL_ID_TEST=-100xxxxxxxxxx

# --- Bluesky (opcional): espejo del feed RSS ---
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your_app_password

# --- Feed RSS de la cuenta a reflejar (opcional) ---
SOCIAL_FEED_TARGET=your_account
SOCIAL_FEED_BASE_URL=http://127.0.0.1:8090

# --- ESPN (opcional) ---
ESPN_CACHE_FILE=espn_cache.json
